# ==============================================================================
# Zulubing Website - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Email Delivery (Gmail API via OAuth2 for Contact & Consultation Forms)
# ------------------------------------------------------------------------------
# Sends through the Gmail REST API (HTTPS) instead of raw SMTP, because many
# hosts (including Render) block outbound SMTP ports. See email-setup.md for
# how to obtain these from Google Cloud Console for development.zulubing@gmail.com.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Database Configuration (MySQL / Drizzle ORM)
# ------------------------------------------------------------------------------
# Format: mysql://<username>:<password>@<host>:<port>/<database_name>
# Optional for local site preview; required if storing users or running drizzle migrations
DATABASE_URL=mysql://root:password@localhost:3306/zulubing

# ------------------------------------------------------------------------------
# 4. Authentication & Security (Optional for local development)
# ------------------------------------------------------------------------------
JWT_SECRET=your_local_jwt_secret_key_change_me_in_production
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# ------------------------------------------------------------------------------
# 5. Storage & Maps Integration (Optional)
# ------------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# ------------------------------------------------------------------------------
# 6. Analytics (Optional)
# ------------------------------------------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
